<Page x:Class="SupporTik.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SupporTik.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="AboutPage">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="24">

                <!-- Заголовок -->
                <TextBlock Text="О программе"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- 1. Главная карточка приложения -->
                <ui:Card Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Логотип программы -->
                        <Border Grid.Column="0"
                                Width="80"
                                Height="80"
                                Background="{DynamicResource ApplicationBackgroundBrush}"
                                CornerRadius="8"
                                Margin="0,0,20,0"
                                VerticalAlignment="Top">
                            <Image Source="/Assets/app_icon.ico"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <!-- Описание и Версия -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,4">
                                <TextBlock Text="SupporTik"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <Border Background="{StaticResource SubtleFillBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="v1.1.0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Универсальный помощник для автоматизации рутины и работы с текстом."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       LineHeight="18">
                                SupporTik разработан для ускорения повседневных задач поддержки и взаимодействия с контентом.
                                Программа позволяет мгновенно вставлять готовые шаблоны, маскировать NDA-данные по нажатию горячих клавиш
                                и работать прямо из системного трея.
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- 2. Виджет с котиком (Кот дня) -->
                <ui:Card Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Минутка отдыха"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Случайный котёнок для хорошего настроения"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"/>
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       Content="Обновить котика"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Appearance="Secondary"
                                       Click="BtnRefreshCat_Click"/>
                        </Grid>

                        <!-- Область отображения картинки -->
                        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                CornerRadius="8"
                                Height="220"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Текст-заглушка во время загрузки -->
                                <TextBlock x:Name="TbCatStatus"
                                           Text="Ищем котика..."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <!-- Сама картинка -->
                                <Image x:Name="ImgCat"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- 3. Дополнительная информация -->
                <ui:Card>
                    <DockPanel>
                        <TextBlock Text="Разработано для внутреннего использования."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="2026 SupporTik"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>