<Page x:Class="SupporTik.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SupporTik.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="800"
      Title="AboutPage">

    <Page.Resources>
        <!-- Карточка -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Кнопка -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Foreground" Value="{StaticResource BgSurface}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="24">

            <!-- Заголовок -->
            <TextBlock Text="О программе" 
                       Foreground="{StaticResource TextPrimary}" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <!-- 1. Главная карточка приложения -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Логотип программы -->
                    <Border Grid.Column="0" 
                            Width="80" 
                            Height="80" 
                            Background="{StaticResource BgPrimary}" 
                            Margin="0,0,20,0"
                            VerticalAlignment="Top">
                        <Image Source="/Assets/app_icon.ico" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Stretch="UniformToFill"/>
                    </Border>

                    <!-- Описание и Версия -->
                    <StackPanel Grid.Column="1" 
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" 
                                    Margin="0,0,0,4">
                            <TextBlock Text="SupporTik" 
                                       Foreground="{StaticResource TextPrimary}" 
                                       FontSize="20" 
                                       FontWeight="Bold"/>
                            <Border Background="{StaticResource BorderColor}" 
                                    CornerRadius="4" 
                                    Padding="6,2" 
                                    Margin="10,0,0,0" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="v1.0.1" 
                                           Foreground="{StaticResource TextSecondary}" 
                                           FontSize="11" 
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Универсальный помощник для автоматизации рутины и работы с текстом." 
                                   Foreground="{StaticResource TextSecondary}" 
                                   FontSize="13" 
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,8"/>

                        <TextBlock Foreground="{StaticResource TextSecondary}" 
                                   FontSize="12" 
                                   TextWrapping="Wrap" 
                                   LineHeight="18">
                            SupporTik разработан для ускорения повседневных задач поддержки и взаимодействия с контентом. 
                            Программа позволяет мгновенно вставлять готовые шаблоны, маскировать NDA-данные по нажатию горячих клавиш 
                            и работать прямо из системного трея.
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Виджет с котиком (Кот дня) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="🐾 Минутка отдыха" 
                                       Foreground="{StaticResource AccentGreen}" 
                                       FontSize="14" 
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Случайный котёнок для хорошего настроения" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       FontSize="12"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="Обновить котика" 
                                Style="{StaticResource RoundedButtonStyle}" 
                                Click="BtnRefreshCat_Click"/>
                    </Grid>

                    <!-- Область отображения картинки -->
                    <Border Background="{StaticResource BgPrimary}" 
                            CornerRadius="8" 
                            Height="220" 
                            ClipToBounds="True">
                        <Grid>
                            <!-- Текст-заглушка во время загрузки -->
                            <TextBlock x:Name="TbCatStatus" 
                                       Text="Ищем котика..." 
                                       Foreground="{StaticResource TextSecondary}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                            <!-- Сама картинка -->
                            <Image x:Name="ImgCat" 
                                   Stretch="Uniform" 
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Дополнительная информация -->
            <Border Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock Text="Разработано для внутреннего использования." 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="12" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="2026 SupporTik" 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="12" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>