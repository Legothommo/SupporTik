<Page x:Class="SupporTik.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000"
      Background="{DynamicResource ApplicationBackgroundBrush}" Title="О приложении">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" MaxWidth="1050" HorizontalAlignment="Center">
            <TextBlock Text="О приложении" FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Информация о SupporTik и небольшая пауза между задачами"
                       Style="{StaticResource DescriptionStyle}" Margin="0,5,0,20"/>

            <ui:Card Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="82" Height="82" CornerRadius="18"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Margin="0,0,20,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo_header.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SupporTik" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Border Background="{StaticResource SubtleFillBrush}" CornerRadius="5"
                                    Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VersionText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Помощник для быстрых ответов, горячих клавиш и работы с рекламными кампаниями."
                                   Style="{StaticResource DescriptionStyle}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ui:Card Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Что умеет SupporTik" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ClipboardPaste24" Margin="0,2,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Быстрые ответы" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Шаблоны, группы и вставка по горячим клавишам" Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ShieldLock24" Margin="0,2,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="NDA-замена" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Маскирование чувствительных фрагментов текста" Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Megaphone24" Margin="0,2,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Меню рекламы" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Поиск кампаний, проверка предложений и готовые тексты" Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="TrayItemAdd24" Margin="0,2,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Работа из трея" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Основные действия доступны без открытого главного окна" Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Сведения о сборке" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                        <TextBlock Text="Версия" Style="{StaticResource DescriptionStyle}"/>
                        <TextBlock Text="{Binding VersionText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,12"/>
                        <TextBlock Text="Среда" Style="{StaticResource DescriptionStyle}"/>
                        <TextBlock Text="{Binding RuntimeText}" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,12"/>
                        <TextBlock Text="Назначение" Style="{StaticResource DescriptionStyle}"/>
                        <TextBlock Text="Внутренний рабочий инструмент" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,18"/>
                        <ui:Button Content="Открыть GitHub" Icon="{ui:SymbolIcon Code24}"
                                   Appearance="Secondary" HorizontalAlignment="Left" Click="BtnOpenGitHub_Click"/>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <ui:Card Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Height="180" CornerRadius="8" ClipToBounds="True"
                            Background="{DynamicResource ApplicationBackgroundBrush}">
                        <Grid>
                            <TextBlock Text="{Binding StatusText}"
                                       Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Image Source="{Binding CatImage}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Минутка отдыха" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Небольшой перерыв иногда экономит больше времени, чем ещё одна задача без паузы."
                                   Style="{StaticResource DescriptionStyle}" Margin="0,5,0,14"/>
                        <ui:Button Content="Другой котик" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Appearance="Secondary" HorizontalAlignment="Left"
                                   Command="{Binding RefreshCatCommand}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <TextBlock Text="SupporTik · 2026" Style="{StaticResource DescriptionStyle}"
                       HorizontalAlignment="Center" Margin="0,2,0,10"/>
        </StackPanel>
    </ScrollViewer>
</Page>
