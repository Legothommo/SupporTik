<Page x:Class="SupporTik.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SupporTik.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="AboutPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FeatureChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SubtleFillBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="24">

                <!-- Заголовок -->
                <TextBlock Text="О программе"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- 1. Главная карточка: логотип, название, версия, ключевые возможности -->
                <ui:Card Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="88"
                                Height="88"
                                CornerRadius="19"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Margin="0,0,20,0"
                                VerticalAlignment="Top">
                            <Image Source="/Assets/logo_header.png"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="SupporTik"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <Border Background="{StaticResource SubtleFillBrush}"
                                        CornerRadius="4"
                                        Padding="7,3"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="v2.1.1"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Универсальный помощник для автоматизации рутины и работы с текстом."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <WrapPanel>
                                <Border Style="{StaticResource FeatureChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Быстрая вставка" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ShieldLock24" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="NDA-маскирование" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Megaphone24" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Меню рекламы" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="TrayItemAdd24" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Работа из трея" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- 2. Виджет с котиком (Кот дня) -->
                <ui:Card Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Минутка отдыха"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Случайный котёнок для хорошего настроения"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"/>
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       Content="Обновить котика"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Appearance="Secondary"
                                       Command="{Binding RefreshCatCommand}"/>
                        </Grid>

                        <!-- Область отображения картинки -->
                        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                CornerRadius="8"
                                Height="220"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Текст-заглушка во время загрузки -->
                                <TextBlock x:Name="TbCatStatus"
                                           Text="{Binding StatusText}"
                                           Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <!-- Сама картинка -->
                                <Image x:Name="ImgCat"
                                       Source="{Binding CatImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- 3. Футер -->
                <ui:Card>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Разработано для внутреннего использования · 2026 SupporTik"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <ui:Button Grid.Column="1"
                                   Content="GitHub"
                                   Icon="{ui:SymbolIcon Code24}"
                                   Appearance="Secondary"
                                   FontSize="12"
                                   Click="BtnOpenGitHub_Click"/>
                    </Grid>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
