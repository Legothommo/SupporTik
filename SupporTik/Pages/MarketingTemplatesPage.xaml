<Page x:Class="SupporTik.Pages.MarketingTemplatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Тексты предложений" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Звезда выбирает основной шаблон категории. Перетаскивайте карточки для сортировки."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Добавить шаблон" Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding AddCommand}" Appearance="Primary" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="TemplatesList"
                     ItemsSource="{Binding Templates}"
                     SelectedItem="{Binding SelectedTemplate}"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="TemplatesList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="TemplatesList_PreviewMouseMove"
                     Drop="TemplatesList_Drop">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                                    Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" ToolTip="Сделать основным">
                                <ui:SymbolIcon Symbol="Star48" Filled="{Binding FavoriteFilled}" Foreground="{StaticResource AccentYellow}"/>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Category}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedTemplate}">
                    <TextBlock Text="Название" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>

                    <TextBlock Text="Теги шаблона" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <WrapPanel Margin="0,6,0,12">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Кампании" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding CampaignScopes}" SelectedItem="{Binding CampaignScope}"
                                      MinWidth="155" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Роль" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding AudienceRoles}" SelectedItem="{Binding AudienceRole}"
                                      MinWidth="130" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Предложение" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding OfferTypes}" SelectedItem="{Binding OfferType}"
                                      MinWidth="175" Margin="0,4,0,0"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Текст шаблона" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180"
                             VerticalScrollBarVisibility="Auto" Margin="0,6,0,8"/>
                    <TextBlock Text="Переменные: {campaign}, {campaigns}, {days}, {amount}, {prediction}, {url}, {urls}, {renewal_details}"
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Предпросмотр" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="6" Padding="12" Margin="0,6,0,16">
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                        <ui:Button Content="Сохранить" Command="{Binding SaveCommand}" Appearance="Primary" Margin="0,0,8,0"/>
                        <ui:Button Content="Создать копию" Command="{Binding DuplicateCommand}" Margin="0,0,8,0"/>
                        <ui:Button Content="Удалить" Command="{Binding DeleteCommand}" Appearance="Danger"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
