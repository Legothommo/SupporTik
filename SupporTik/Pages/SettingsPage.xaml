<Page x:Class="SupporTik.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SupporTik.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="SettingsPage">

    <Page.Resources>
        <!-- Стиль подзаголовков секций -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Стиль описания настроек -->
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">

                <!-- Заголовок страницы -->
                <TextBlock Text="Настройки"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- 1. Секция: Поведение и Запуск -->
                <ui:Card Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ПОВЕДЕНИЕ И ЗАПУСК"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Автозапуск -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Запускать вместе с Windows"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontSize="14"/>
                                <TextBlock Text="Автоматический запуск программы при входе в систему"
                                           Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ChkAutoStart"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Click="ChkAutoStart_Click"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderSubtleBrush}"
                                   Margin="0,4,0,12"/>

                        <!-- Сворачивание в трей при закрытии -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Сворачивать в трей при закрытии"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontSize="14"/>
                                <TextBlock Text="При нажатии на крестик окно будет скрываться в системный трей"
                                           Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ChkMinimizeToTray"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="True"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderSubtleBrush}"
                                   Margin="0,4,0,12"/>

                        <!-- Запуск свернутым -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Запускать в свернутом виде"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontSize="14"/>
                                <TextBlock Text="При старте приложения сразу скрывать его в трей"
                                           Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ChkStartMinimized"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 2. Секция: NDA Замена -->
                <ui:Card Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="NDA ЗАМЕНА"
                                   Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Сочетание клавиш:"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,4"/>
                            <Border x:Name="HotkeyCaptureArea"
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    Focusable="True"
                                    MouseDown="HotkeyCaptureArea_MouseDown"
                                    LostFocus="HotkeyCaptureArea_LostFocus">
                                <Grid>
                                    <TextBlock x:Name="TbHotkeyDisplay"
                                               Text="Нажмите для назначения..."
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 3. Секция: Импорт и Экспорт -->
                <ui:Card Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ИМПОРТ И ЭКСПОРТ"
                                   Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0"
                                       Content="Импорт"
                                       Icon="{ui:SymbolIcon ArrowImport24}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,10,5,10"
                                       Height="34"
                                       Click="Import_Click"/>
                            <ui:Button Grid.Column="1"
                                       Content="Экспорт"
                                       Icon="{ui:SymbolIcon ArrowExport24}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       Margin="5,10,0,10"
                                       Height="34"
                                       Click="Export_Click"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Кнопка сохранения -->
                <ui:Button x:Name="BtnSave"
                           Content="Сохранить настройки"
                           Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary"
                           HorizontalAlignment="Right"
                           Click="BtnSave_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>