<Page x:Class="SupporTik.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000"
      Background="{DynamicResource ApplicationBackgroundBrush}" Title="Настройки">
    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CaptureAreaStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" MaxWidth="1050" HorizontalAlignment="Center">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Настройки" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Поведение приложения, горячие клавиши и обслуживание данных"
                               Style="{StaticResource DescriptionStyle}" Margin="0,5,0,0"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Content="Сохранить" Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary" Command="{Binding SaveCommand}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ui:Card Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,9,0"/>
                                <TextBlock Text="Приложение" Style="{StaticResource SectionTitleStyle}"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource SettingTitleStyle}"/>
                                    <TextBlock Text="Автоматически запускать после входа в систему" Style="{StaticResource DescriptionStyle}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"/>
                            </Grid>
                            <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Сворачивать в трей" Style="{StaticResource SettingTitleStyle}"/>
                                    <TextBlock Text="Крестик скрывает окно, приложение продолжает работать" Style="{StaticResource DescriptionStyle}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>
                            </Grid>
                            <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Запускать свёрнутым" Style="{StaticResource SettingTitleStyle}"/>
                                    <TextBlock Text="При старте сразу скрывать главное окно в трей" Style="{StaticResource DescriptionStyle}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding StartMinimized, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <ui:SymbolIcon Symbol="ClipboardPaste24" Margin="0,0,9,0"/>
                                <TextBlock Text="Горячие клавиши" Style="{StaticResource SectionTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="NDA-замена" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="Нажмите на поле и введите сочетание" Style="{StaticResource DescriptionStyle}" Margin="0,2,0,7"/>
                            <Border x:Name="HotkeyCaptureArea" Style="{StaticResource CaptureAreaStyle}"
                                    MouseDown="HotkeyCaptureArea_MouseDown" LostFocus="HotkeyCaptureArea_LostFocus" Margin="0,0,0,16">
                                <TextBlock x:Name="TbHotkeyDisplay" Text="{Binding NdaHotkeyDisplay}" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="Меню рекламы" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="Открывает поиск рекламных кампаний" Style="{StaticResource DescriptionStyle}" Margin="0,2,0,7"/>
                            <Border x:Name="MarketingHotkeyCaptureArea" Style="{StaticResource CaptureAreaStyle}"
                                    MouseDown="MarketingHotkeyCaptureArea_MouseDown" LostFocus="MarketingHotkeyCaptureArea_LostFocus" Margin="0,0,0,14">
                                <TextBlock x:Name="TbMarketingHotkeyDisplay" Text="{Binding MarketingHotkeyDisplay}" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                            </Border>
                            <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Открывать меню слева" Style="{StaticResource SettingTitleStyle}"/>
                                    <TextBlock Text="По умолчанию окно появляется справа" Style="{StaticResource DescriptionStyle}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding MarketingMenuFromLeft, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <ui:Card Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,9,0"/>
                                <TextBlock Text="Данные и обслуживание" Style="{StaticResource SectionTitleStyle}"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Обновления" Style="{StaticResource SettingTitleStyle}"/>
                                    <TextBlock Text="Проверка также выполняется при запуске" Style="{StaticResource DescriptionStyle}"/>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="{Binding CheckUpdatesLabel}" Icon="{ui:SymbolIcon ArrowSync24}"
                                           Appearance="Secondary" Command="{Binding CheckUpdatesCommand}" Margin="12,0,0,0"/>
                            </Grid>
                            <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="Перенос данных" Style="{StaticResource SettingTitleStyle}"/>
                            <TextBlock Text="Выберите данные для экспорта. При импорте изменятся только разделы, которые есть в файле."
                                       Style="{StaticResource DescriptionStyle}" Margin="0,2,0,10"/>
                            <WrapPanel Margin="0,0,0,12">
                                <CheckBox Content="Бинды" IsChecked="{Binding ExportBinds}" Margin="0,0,18,6"/>
                                <CheckBox Content="Настройки" IsChecked="{Binding ExportSettings}" Margin="0,0,18,6"/>
                                <CheckBox Content="Рекламные шаблоны" IsChecked="{Binding ExportMarketingTemplates}" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="Импорт" Icon="{ui:SymbolIcon ArrowImport24}"
                                           Appearance="Secondary" Command="{Binding ImportCommand}" HorizontalAlignment="Stretch"/>
                                <ui:Button Grid.Column="2" Content="Экспорт" Icon="{ui:SymbolIcon ArrowExport24}"
                                           Appearance="Secondary" Command="{Binding ExportCommand}" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <ui:SymbolIcon Symbol="ShieldLock24" Margin="0,0,9,0"/>
                                <TextBlock Text="Авторизация" Style="{StaticResource SectionTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="Сбросить сохранённые сессии Яндекс Бизнеса и DataLens. При следующем открытии меню потребуется войти заново."
                                       Style="{StaticResource DescriptionStyle}" Margin="0,0,0,12"/>
                            <ui:Button Content="Выйти из аккаунтов" Icon="{ui:SymbolIcon SignOut24}"
                                       Appearance="Secondary" HorizontalAlignment="Left" Command="{Binding ClearAuthorizationCommand}"/>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Сброс настроек" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <TextBlock Text="Вернуть настройки приложения к исходным значениям. Пользовательские бинды останутся на месте."
                                       Style="{StaticResource DescriptionStyle}" Margin="0,0,0,12"/>
                            <ui:Button Content="Сбросить настройки" Icon="{ui:SymbolIcon ArrowReset24}"
                                       Appearance="Danger" HorizontalAlignment="Left" Command="{Binding ResetCommand}"/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
