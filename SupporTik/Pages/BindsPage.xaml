<Page x:Class="SupporTik.Pages.BindsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SupporTik.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BindsPage">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Поиск -->
            <RowDefinition Height="*"/>
            <!-- Список шаблонов -->
            <RowDefinition Height="Auto"/>
            <!-- Статус бар -->
        </Grid.RowDefinitions>

        <!-- 1. Верхняя панель (Поиск + Кнопка Добавить) -->
        <Grid Grid.Row="0" Margin="20,20,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="TbSearch"
                        Grid.Column="0"
                        PlaceholderText="Поиск шаблонов..."
                        Icon="{ui:SymbolIcon Search24}"
                        FontSize="14"
                        TextChanged="TbSearch_TextChanged"/>

            <ui:Button Grid.Column="1"
                       Content="Новый шаблон"
                       Icon="{ui:SymbolIcon Add24}"
                       Appearance="Primary"
                       Margin="10,0,0,0"
                       Click="BtnAddBind"/>
        </Grid>

        <!-- 2. Список шаблонов (Карточки) -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,0" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="sp_list"/>
        </ScrollViewer>

        <!-- 3. Нижний статус-бар -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,12,20,20">
            <Ellipse x:Name="Status" Width="8" Height="8" Fill="{StaticResource StatusActiveBrush}" Margin="0,0,6,0"/>
            <TextBlock x:Name="TbText" Text="Перехват клавиш активен" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
        </StackPanel>
    </Grid>
</Page>
