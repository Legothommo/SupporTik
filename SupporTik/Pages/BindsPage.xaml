<Page x:Class="SupporTik.Pages.BindsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SupporTik.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BindsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Поиск -->
            <RowDefinition Height="*"/>
            <!-- Список шаблонов -->
            <RowDefinition Height="Auto"/>
            <!-- Статус бар -->
        </Grid.RowDefinitions>

        <!-- 1. Верхняя панель (Поиск + Кнопка Добавить) -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TbSearch"
                     Background="{StaticResource BgSurface}" 
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderColor}"
                     Style="{StaticResource SearchTextBoxStyle}"
                     Padding="8,6" FontSize="14" TextChanged="TbSearch_TextChanged"/>

            <Button Grid.Column="1" Content="+ Новый шаблон" 
                    Background="{StaticResource AccentGreen}" 
                    Foreground="#1E1E24" FontWeight="Bold"
                    Padding="12,6" Margin="10,0,0,0" Click="BtnAddBind"/>
        </Grid>

        <!-- 2. Список шаблонов (Карточки) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="sp_list">
                
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Нижний статус-бар -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Ellipse x:Name="Status" Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0"/>
            <TextBlock x:Name="TbText" Text="Перехват клавиш активен" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
        </StackPanel>
    </Grid>
</Page>
