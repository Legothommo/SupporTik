    <!-- Пакет Microsoft.Web.WebView2 должен сам копировать нативные WebView2Loader.dll
         под каждую архитектуру в подпапки runtimes\win-*\native\, но в этом (не-SDK)
         проекте это почему-то не срабатывает — без них окно "Меню рекламы" падает
         при инициализации WebView2 на системах с архитектурой, отличной от той, что
         используется при разработке. Копируем нативные загрузчики для всех архитектур,
         сохраняя структуру папок runtimes\win-*\native\, как и предполагает пакет. -->
    <None Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll')">
      <Link>runtimes\win-x64\native\WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll" Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll')">
      <Link>runtimes\win-x86\native\WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll" Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll')">
      <Link>runtimes\win-arm64\native\WebView2Loader.dll</Link>
