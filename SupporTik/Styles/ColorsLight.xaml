<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Светлый вариант палитры — те же ключи, что и в Colors.xaml (тёмная), значения
         подобраны так, чтобы сохранить тот же пастельный акцент базы #2B2D42 на светлом фоне. -->

    <SolidColorBrush x:Key="AccentGreen" Color="#81B29A"/>
    <SolidColorBrush x:Key="AccentCoral" Color="#E07A5F"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#F2CC8F"/>

    <!-- Фон окна — чуть темнее (сероватее) базы, для глубины под карточками -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F1F2F8"/>

    <!-- Карточки/поверхности -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#DEE1EC"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#20222F"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5F6380"/>

    <!-- Пастельные акценты для статусов — чуть насыщеннее тёмного варианта, чтобы не
         "вымываться" на светлом фоне -->
    <SolidColorBrush x:Key="StatusActiveBrush" Color="#3FA679"/>
    <SolidColorBrush x:Key="StatusPausedBrush" Color="#D9647F"/>

    <!-- Вспомогательные нейтральные -->
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#DEE1EC"/>

</ResourceDictionary>
