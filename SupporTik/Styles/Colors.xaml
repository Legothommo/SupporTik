<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Старая палитра — больше активно не используется (оставлена как подстраховка) -->
    <SolidColorBrush x:Key="BgPrimary" Color="#1E1E24"/>
    <SolidColorBrush x:Key="BgSurface" Color="#2B2D42"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3D405B"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F4F1DE"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9A8C98"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#81B29A"/>
    <SolidColorBrush x:Key="AccentCoral" Color="#E07A5F"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#F2CC8F"/>

    <!-- ============================================================
         Пастельная палитра поверх Fluent-темы. База — #2B2D42 (тёмный
         индиго), вокруг неё — мягкие пастельные акценты. Единое место
         для дальнейшей цветовой коррекции.
         ============================================================ -->

    <!-- Фон окна — чуть темнее базы, для глубины под карточками -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#20222F"/>

    <!-- Карточки/поверхности — сама база -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2B2D42"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#2B2D42"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3D405B"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F1EFFA"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#ADB0C7"/>

    <!-- Пастельные акценты для статусов -->
    <SolidColorBrush x:Key="StatusActiveBrush" Color="#A8E6CF"/>
    <SolidColorBrush x:Key="StatusPausedBrush" Color="#F4A9B8"/>

    <!-- Вспомогательные нейтральные -->
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#3D405B"/>

</ResourceDictionary>
