<UserControl x:Class="SupporTik.Controls.MarketingItemPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignWidth="380">

    <ui:Card x:Name="Card" Margin="0,0,0,8">
        <StackPanel>

            <!-- Заголовок: выбор + пермалинк + статус -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TbPermalink"
                           Grid.Column="0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,8,0"/>

                <Border x:Name="BrStatus"
                        Grid.Column="1"
                        Background="{StaticResource SubtleFillBrush}"
                        CornerRadius="4"
                        Padding="8,3"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="TbStatus"
                               Foreground="Black"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- Остаток и роль -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ОСТАТОК"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TbRemain"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="sp_role" Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="РОЛЬ"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TbRole"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <CheckBox x:Name="ChkSelect"
                          VerticalAlignment="Center" Click="ChkSelect_Click"/>

                <ui:Button x:Name="BtnOpen"
                       Content="Открыть"
                       Icon="{ui:SymbolIcon Open24}"
                       Appearance="Secondary"
                       HorizontalAlignment="Right"
                       FontSize="12"
                       Padding="10,4"
                       Click="BtnOpen_Click"/>
            </StackPanel>
        </StackPanel>
    </ui:Card>
</UserControl>
