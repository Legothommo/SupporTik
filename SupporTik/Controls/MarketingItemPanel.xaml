<UserControl x:Class="SupporTik.Controls.MarketingItemPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:SupporTik.Converters"
             mc:Ignorable="d"
             d:DesignWidth="380">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StatusToBadgeBrushConverter x:Key="StatusToBadgeBrush"/>
        <conv:StatusToTextForegroundConverter x:Key="StatusToTextForeground"/>
    </UserControl.Resources>

    <ui:Card x:Name="Card">
        <StackPanel>

            <!-- Заголовок: выбор + пермалинк + копирование + статус -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TbPermalink"
                           Grid.Column="0"
                           Text="{Binding DisplayPermalink}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>

                <ui:Button Grid.Column="1"
                           Icon="{ui:SymbolIcon Copy24}"
                           Command="{Binding CopyPermalinkCommand}"
                           Appearance="Transparent"
                           Padding="4"
                           Margin="0,0,4,0"
                           ToolTip="Скопировать пермалинк"/>

                <Border x:Name="BrStatus"
                        Grid.Column="2"
                        Background="{Binding StatusKey, Converter={StaticResource StatusToBadgeBrush}}"
                        CornerRadius="4"
                        Padding="8,3"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="TbStatus"
                               Text="{Binding DisplayStatus}"
                               Foreground="{Binding StatusKey, Converter={StaticResource StatusToTextForeground}}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- Остаток, роль и апсейл -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ОСТАТОК"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TbRemain"
                               Text="{Binding DisplayRemain}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="12"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel x:Name="sp_role"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Visibility="{Binding HasRole, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="РОЛЬ"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TbRole"
                               Text="{Binding Role}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="12"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel x:Name="sp_upsale"
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            Visibility="{Binding HasUpsale, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="АПСЕЙЛ"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TbUpsale"
                               Text="{Binding UpsaleDisplayValue}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="12"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Right">

                <CheckBox x:Name="ChkSelect"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center"/>

                <ui:Button Content="Копировать"
                           Icon="{ui:SymbolIcon ClipboardPaste24}"
                           Click="CopyUpsale_Click"
                           Visibility="{Binding CanCopyUpsale, Converter={StaticResource BoolToVis}}"
                           Appearance="Secondary"
                           Margin="8,0,0,0"
                           FontSize="12"
                           Padding="10,4"/>

                <ui:Button x:Name="BtnOpen"
                           Content="Открыть"
                           Icon="{ui:SymbolIcon Open24}"
                           Command="{Binding OpenCommand}"
                           Appearance="Secondary"
                           Margin="8,0,0,0"
                           FontSize="12"
                           Padding="10,4"/>
            </StackPanel>
        </StackPanel>
    </ui:Card>
</UserControl>
