<UserControl x:Class="SupporTik.Controls.MarketingItemPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:SupporTik.Converters"
             mc:Ignorable="d"
             d:DesignWidth="380">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StatusToBadgeBrushConverter x:Key="StatusToBadgeBrush"/>
        <conv:StatusToTextForegroundConverter x:Key="StatusToTextForeground"/>
    </UserControl.Resources>

    <ui:Card x:Name="Card" Margin="0,0,0,8">
        <StackPanel>

            <!-- Заголовок: выбор + пермалинк + статус -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TbPermalink"
                           Grid.Column="0"
                           Text="{Binding DisplayPermalink}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,8,0"/>

                <Border x:Name="BrStatus"
                        Grid.Column="1"
                        Background="{Binding StatusKey, Converter={StaticResource StatusToBadgeBrush}}"
                        CornerRadius="4"
                        Padding="8,3"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="TbStatus"
                               Text="{Binding DisplayStatus}"
                               Foreground="{Binding StatusKey, Converter={StaticResource StatusToTextForeground}}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- Остаток и роль -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ОСТАТОК"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TbRemain"
                               Text="{Binding DisplayRemain}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="sp_role"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Visibility="{Binding HasRole, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="РОЛЬ"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TbRole"
                               Text="{Binding Role}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <CheckBox x:Name="ChkSelect"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center"/>

                <ui:Button x:Name="BtnOpen"
                       Content="Открыть"
                       Icon="{ui:SymbolIcon Open24}"
                       Command="{Binding OpenCommand}"
                       Appearance="Secondary"
                       HorizontalAlignment="Right"
                       FontSize="12"
                       Padding="10,4"/>
            </StackPanel>
        </StackPanel>
    </ui:Card>
</UserControl>
