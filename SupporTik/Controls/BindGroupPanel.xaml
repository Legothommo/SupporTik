<UserControl x:Class="SupporTik.Controls.BindGroupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="800">

    <Border Style="{StaticResource TemplateCardStyle}"
            BorderBrush="{StaticResource AccentGreen}"
            BorderThickness="1.5">
        <StackPanel>

            <!-- Заголовок группы: значок папки, название/число шаблонов и общий хоткей -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="📁"
                           FontSize="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"/>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel x:Name="sp_titleDisplay">
                        <TextBlock x:Name="TbGroupTitle"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TbGroupSubtitle"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"/>
                    </StackPanel>

                    <TextBox x:Name="TbGroupNameInput"
                             Style="{StaticResource InputTextBoxStyle}"
                             Padding="6,4"
                             FontSize="13"
                             Visibility="Collapsed"
                             KeyDown="TbGroupNameInput_KeyDown"
                             LostFocus="TbGroupNameInput_LostFocus"/>
                </Grid>

                <Button Grid.Column="2"
                        x:Name="BtnRenameGroup"
                        Content="✏"
                        Width="22"
                        Height="22"
                        Margin="6,0"
                        Style="{StaticResource TitleBarBtnStyle}"
                        ToolTip="Назвать группу"
                        Click="BtnRenameGroup_Click"/>

                <Border Grid.Column="3"
                        Style="{StaticResource HotkeyBadgeStyle}"
                        Height="20">
                    <TextBlock x:Name="TbKeys"
                               Foreground="{StaticResource AccentGreen}"
                               FontFamily="Consolas"
                               FontSize="12"/>
                </Border>
            </Grid>

            <!-- Строки шаблонов, входящих в группу -->
            <StackPanel x:Name="sp_rows"/>

            <Button Content="+ Добавить шаблон с этим сочетанием"
                    Style="{StaticResource SecondaryBtnStyle}"
                    HorizontalAlignment="Stretch"
                    Padding="8,6"
                    Margin="0,8,0,0"
                    FontSize="12"
                    Click="BtnAddToGroup_Click"/>
        </StackPanel>
    </Border>
</UserControl>
