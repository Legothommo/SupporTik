<UserControl x:Class="SupporTik.Controls.BindPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SupporTik.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Анимация ОТКРЫТИЯ меню -->
        <Storyboard x:Key="OpenMenu">
            <DoubleAnimation Storyboard.TargetName="EditMenu"
                             Storyboard.TargetProperty="Height"
                             To="35" 
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Анимация ЗАКРЫТИЯ меню -->
        <Storyboard x:Key="CloseMenu">
            <DoubleAnimation Storyboard.TargetName="EditMenu"
                             Storyboard.TargetProperty="Height"
                             To="0" 
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Border Style="{StaticResource TemplateCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Шапка карточки (Название и Хоткей) -->
            <TextBlock x:Name="TbName"
                       Grid.Row="0"
                       Text="" 
                       Foreground="{StaticResource TextPrimary}"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold" 
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,80,0"/>

            <Border Grid.Row="0"
                    Style="{StaticResource HotkeyBadgeStyle}" 
                    HorizontalAlignment="Right" 
                    Height="20">
                <TextBlock x:Name="TbKeys" 
                           Text="" 
                           Foreground="{StaticResource AccentGreen}" 
                           FontFamily="Consolas" 
                           FontSize="12"/>
            </Border>

            <!-- 2. Текст шаблона -->
            <TextBlock x:Name="TbText"
                       Grid.Row="1" 
                       Text="" 
                       Foreground="{StaticResource TextSecondary}" 
                       Margin="0,6,0,0" 
                       TextTrimming="CharacterEllipsis" 
                       TextWrapping="Wrap"/>

            <!-- 3. Панель кнопок редактирования / удаления -->
            <StackPanel x:Name="EditMenu" 
                        Grid.Row="2" 
                        Orientation="Horizontal" 
                        Margin="5" 
                        HorizontalAlignment="Center" 
                        Height="0">
                <Button Content="Редактировать" 
                        Padding="5" 
                        Width="100" 
                        Margin="5" 
                        Style="{StaticResource EditBtnStyle}" 
                        Click="EditHotkey_Click"/>
                <Button Content="Удалить" 
                        Padding="5" 
                        Width="100" 
                        Margin="5" 
                        Style="{StaticResource DeleteBtnStyle}" 
                        Click="DeleteHotkey_Click"/>
            </StackPanel>

            <!-- 4. Кнопка раскрытия меню -->
            <Button Grid.Row="3" 
                    Style="{StaticResource TitleBarBtnStyle}" 
                    Height="20" 
                    Width="20" 
                    Margin="0,4,0,0"
                    Click="Menu_Click">
                <TextBlock x:Name="ArrowText" 
                           Text="▲" 
                           Foreground="{StaticResource TextSecondary}"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="ArrowTransform" Angle="180"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Button>
        </Grid>
    </Border>
</UserControl>