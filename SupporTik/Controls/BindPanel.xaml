<UserControl x:Class="SupporTik.Controls.BindPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SupporTik.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Анимация ОТКРЫТИЯ меню -->
            <Storyboard x:Key="OpenMenu">
                <DoubleAnimation Storyboard.TargetName="EditMenu"
                                 Storyboard.TargetProperty="Height"
                                 To="44"
                                 Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Анимация ЗАКРЫТИЯ меню -->
            <Storyboard x:Key="CloseMenu">
                <DoubleAnimation Storyboard.TargetName="EditMenu"
                                 Storyboard.TargetProperty="Height"
                                 To="0"
                                 Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <ui:Card Margin="0,0,0,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Шапка карточки (Название и Хоткей) -->
            <TextBlock x:Name="TbName"
                       Grid.Row="0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,90,0"/>

            <Border Grid.Row="0"
                    Background="{StaticResource SubtleFillBrush}"
                    CornerRadius="4"
                    Padding="8,3"
                    HorizontalAlignment="Right"
                    Height="22">
                <TextBlock x:Name="TbKeys"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontFamily="Consolas"
                           FontSize="12"/>
            </Border>

            <!-- 2. Текст шаблона -->
            <TextBlock x:Name="TbText"
                       Grid.Row="1"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"/>

            <!-- 3. Панель кнопок редактирования / удаления -->
            <StackPanel x:Name="EditMenu"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Height="0"
                        ClipToBounds="True">
                <ui:Button Content="Редактировать"
                           Icon="{ui:SymbolIcon Edit24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Click="EditHotkey_Click"/>
                <ui:Button Content="Удалить"
                           Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Danger"
                           Click="DeleteHotkey_Click"/>
            </StackPanel>

            <!-- 4. Кнопка раскрытия меню -->
            <ui:Button Grid.Row="3"
                       Appearance="Transparent"
                       Padding="6,4"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       Click="Menu_Click">
                <ui:SymbolIcon Symbol="ChevronDown24"
                               RenderTransformOrigin="0.5,0.5">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform x:Name="ArrowTransform" Angle="180"/>
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </ui:Button>
        </Grid>
    </ui:Card>
</UserControl>