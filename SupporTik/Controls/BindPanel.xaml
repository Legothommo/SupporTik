<UserControl x:Class="SupporTik.Controls.BindPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SupporTik.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:SupporTik.Converters"
             mc:Ignorable="d"
             d:DesignWidth="380">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <ui:Card Margin="0,0,0,10"
             BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
             BorderThickness="1">
        <StackPanel>

            <!-- Заголовок: название (инлайн-редактируемое) + хоткей -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TbName"
                               Text="{Binding Name}"
                               Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVis}}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"/>

                    <ui:TextBox x:Name="TbNameInput"
                                Text="{Binding NameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}"
                                FontSize="14"
                                KeyDown="NameInput_KeyDown"
                                LostFocus="NameInput_LostFocus"/>
                </Grid>

                <ui:Button Grid.Column="1"
                           Icon="{ui:SymbolIcon Edit24}"
                           Appearance="Transparent"
                           Padding="4"
                           Margin="6,0"
                           ToolTip="Переименовать"
                           Command="{Binding StartEditNameCommand}"/>

                <Border Grid.Column="2"
                        Background="{StaticResource SubtleFillBrush}"
                        CornerRadius="4"
                        Padding="8,3"
                        Height="22">
                    <TextBlock x:Name="TbKeys"
                               Text="{Binding KeysDisplay}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="12"/>
                </Border>
            </Grid>

            <!-- Текст шаблона (тоже инлайн-редактируемый) -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TbText"
                           Grid.Column="0"
                           Text="{Binding Text}"
                           Visibility="{Binding IsEditingText, Converter={StaticResource InverseBoolToVis}}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <ui:TextBox x:Name="TbTextInput"
                            Grid.Column="0"
                            Text="{Binding TextInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding IsEditingText, Converter={StaticResource BoolToVis}}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MaxHeight="120"
                            VerticalScrollBarVisibility="Auto"
                            KeyDown="TextInput_KeyDown"
                            LostFocus="TextInput_LostFocus"/>

                <ui:Button Grid.Column="1"
                           Icon="{ui:SymbolIcon Edit24}"
                           Appearance="Transparent"
                           Padding="4"
                           Margin="6,0,0,0"
                           VerticalAlignment="Top"
                           ToolTip="Изменить текст"
                           Command="{Binding StartEditTextCommand}"/>
            </Grid>

            <!-- Удаление -->
            <ui:Button Content="Удалить"
                       Icon="{ui:SymbolIcon Delete24}"
                       Appearance="Danger"
                       HorizontalAlignment="Right"
                       FontSize="12"
                       Command="{Binding DeleteCommand}"/>
        </StackPanel>
    </ui:Card>
</UserControl>
