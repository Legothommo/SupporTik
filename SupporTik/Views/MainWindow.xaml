<Window x:Class="SupporTik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SupporTik"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="QuickPaste"
        Height="800"
        Width="1100"
        MinHeight="450"
        MinWidth="650"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Анимация ОТКРЫТИЯ меню -->
        <Storyboard x:Key="OpenMenu">
            <!-- Раскрываем ширину меню от 0 до 200 за 0.25 секунды -->
            <DoubleAnimation Storyboard.TargetName="SideMenu"
                             Storyboard.TargetProperty="Width"
                             To="200"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Плавное появление полупрозрачного фона -->
            <DoubleAnimation Storyboard.TargetName="Overlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0.5"
                             Duration="0:0:0.25"/>
        </Storyboard>

        <!-- Анимация ЗАКРЫТИЯ меню -->
        <Storyboard x:Key="CloseMenu">
            <DoubleAnimation Storyboard.TargetName="SideMenu"
                             Storyboard.TargetProperty="Width"
                             To="0"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="Overlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0"
                             Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Grid Margin="10">
        <!-- Основная область окна -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кастомная шапка -->
            <Grid Grid.Row="0" Background="{DynamicResource ApplicationBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="8,0">
                    <ui:Button x:Name="BtnBurger"
                               Icon="{ui:SymbolIcon Navigation24}"
                               Command="{Binding ToggleMenuCommand}"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               Appearance="Transparent"
                               Padding="6,4"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="12,0">
                    <Image Source="/Assets/logo_header.png"
                           Width="20"
                           Height="20"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="SupporTik"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Кнопки управления окном (IsHitTestVisibleInChrome для кликабельности) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:Button Icon="{ui:SymbolIcon Subtract24}"
                               Click="Minimize_Click"
                               Appearance="Transparent"
                               Padding="6,4"/>
                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}"
                               Click="Close_Click"
                               Appearance="Transparent"
                               Padding="6,4">
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Основной контент -->
            <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Margin="5"/>
        </Grid>

        <!-- Затемнение при открытом меню -->
        <Border x:Name="Overlay"
                Background="Black"
                Opacity="0"
                IsHitTestVisible="False"
                MouseDown="Overlay_MouseDown"/>

        <!-- ВЫДВИЖНОЕ МЕНЮ (SideMenu) -->
        <Border x:Name="SideMenu"
                Width="0"
                HorizontalAlignment="Left"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <StackPanel Margin="12">
                    <TextBlock Text="МЕНЮ"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="8,0,0,10"/>

                    <ui:Button Content="Все шаблоны"
                               Icon="{ui:SymbolIcon DocumentBulletList24}"
                               Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,0,0,4"
                               Click="GoToBinds"/>
                    <ui:Button Content="Настройки"
                               Icon="{ui:SymbolIcon Settings24}"
                               Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,0,0,4"
                               Click="GoToSettings"/>

                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,6"/>

                    <ui:Button Content="О программе"
                               Icon="{ui:SymbolIcon Info24}"
                               Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Click="GoToAbout"/>

                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,6"/>

                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Светлая тема"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding IsLightTheme, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>

                <Border Background="{StaticResource SubtleFillBrush}"
                        CornerRadius="4"
                        Width="44"
                        Padding="6,2"
                        Margin="10"
                        VerticalAlignment="Bottom">
                    <TextBlock Text="v2.4.0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>