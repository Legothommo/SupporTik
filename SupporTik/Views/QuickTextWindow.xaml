<Window x:Class="SupporTik.QuickTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SupporTik"
        mc:Ignorable="d"
        Title="QuickPaste Menu" 
        SizeToContent="WidthAndHeight" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Topmost="True" 
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        Background="Transparent"
        MaxHeight="300"
        ResizeMode="NoResize">

    <!-- Карточка-меню с закруглениями и тенью -->
    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10" 
            Padding="8"
            Margin="10">

        <!-- Тень от окна -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" 
                              Color="Black" 
                              Opacity="0.4" 
                              ShadowDepth="3"/>
        </Border.Effect>

        <StackPanel Width="220">
            <!-- Название папки (если задано) -->
            <TextBlock x:Name="TbGroupTitle"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="10,4,10,4"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed"/>

            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="sp_binds"/>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>