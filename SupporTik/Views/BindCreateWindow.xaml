<Window x:Class="SupporTik.Pages.BindCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SupporTik.Pages"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Height="450"
        Width="650"
        MinHeight="450"
        MinWidth="650"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Title="BindCreateWindow">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Кастомная шапка окна -->
        <Grid Grid.Row="0"
              Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TbLabel"
                       Grid.Column="0"
                       Text="Добавление бинда"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="12,0"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <ui:Button Icon="{ui:SymbolIcon Subtract24}"
                           Click="Minimize_Click"
                           Appearance="Transparent"
                           Padding="6,4"/>
                <ui:Button Icon="{ui:SymbolIcon Dismiss24}"
                           Click="Close_Click"
                           Appearance="Transparent"
                           Padding="6,4"/>
            </StackPanel>
        </Grid>

        <!-- 2. Основное содержимое формы -->
        <Grid Grid.Row="1"
              Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Название бинда -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,12">
                <TextBlock Text="Название (для меню):"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <ui:TextBox x:Name="TbName"/>
            </StackPanel>

            <!-- Область записи хоткея -->
            <StackPanel Grid.Row="1"
                        Margin="0,0,0,12">
                <TextBlock Text="Сочетание клавиш:"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <Border x:Name="HotkeyCaptureArea"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Focusable="True"
                        MouseDown="HotkeyCaptureArea_MouseDown"
                        LostFocus="HotkeyCaptureArea_LostFocus">
                    <Grid>
                        <TextBlock x:Name="TbHotkeyDisplay"
                                   Text="Нажмите, чтобы задать хоткей..."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Текст для автовставки -->
            <StackPanel Grid.Row="2"
                        Margin="0,0,0,15">
                <TextBlock Text="Текст для автовставки:"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <ui:TextBox x:Name="TbText"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Height="100"
                            VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Кнопки действия -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button Content="Отмена"
                           Width="90"
                           Height="32"
                           Click="BtnCancel_Click"
                           Appearance="Secondary"
                           Margin="0,0,8,0"/>
                <ui:Button Content="Сохранить"
                           Width="100"
                           Height="32"
                           Click="BtnSave_Click"
                           Appearance="Primary"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>