<Window x:Class="SupporTik.Views.MarketingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:SupporTik.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:SupporTik.Controls"
        xmlns:vm="clr-namespace:SupporTik.ViewModels"
        mc:Ignorable="d"
        Title="Меню рекламы"
        Width="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate DataType="{x:Type vm:MarketingItemViewModel}">
            <controls:MarketingItemPanel/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="Auto"/>
            <!-- Статус авторизации -->
            <RowDefinition Height="Auto"/>
            <!-- WebView2 для входа -->
            <RowDefinition Height="Auto"/>
            <!-- Поиск -->
            <RowDefinition Height="Auto"/>
            <!-- Фильтр по статусу -->
            <RowDefinition Height="Auto"/>
            <!-- Действия с выбранными -->
            <RowDefinition Height="*"/>
            <!-- Результаты -->
        </Grid.RowDefinitions>

        <!-- 1. Шапка -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Меню рекламы"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <ui:Button Grid.Column="1"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Appearance="Transparent"
                       Padding="6,4"
                       WindowChrome.IsHitTestVisibleInChrome="True"
                       Click="Close_Click"/>
        </Grid>

        <!-- 2. Статус авторизации -->
        <TextBlock x:Name="TbLoginStatus"
                   Grid.Row="1"
                   Text="Проверка авторизации..."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Visibility="Collapsed"/>

        <!-- 3. Окно входа — видно только пока пользователь ещё не авторизован -->
        <wv2:WebView2 x:Name="webView"
                      Grid.Row="2"
                      Height="380"
                      Visibility="Collapsed"
                      Margin="0,0,0,10"/>

        <!-- 4. Поиск по UID — появляется после успешной авторизации -->
        <StackPanel x:Name="sp_search"
                    Grid.Row="3"
                    Orientation="Horizontal"
                    Visibility="{Binding IsSearchUiVisible, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,10">
            <ui:TextBox x:Name="UidTextBox"
                        Width="140"
                        PlaceholderText="UID пользователя"
                        Text="{Binding Uid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,8,0"/>
            <ui:Button x:Name="SearchButton"
                       Content="{Binding SearchButtonLabel}"
                       Icon="{ui:SymbolIcon Search24}"
                       Appearance="Primary"
                       Margin="0,0,8,0"
                       Command="{Binding SearchCommand}"/>
            <ui:ProgressRing Width="18"
                              Height="18"
                              IsIndeterminate="True"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
            <CheckBox x:Name="ChkSearchRoles"
                      Content="Роли"
                      IsChecked="{Binding SearchRoles, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      FontSize="12"
                      ToolTip="Искать и показывать роль пользователя в каждой кампании"/>
        </StackPanel>

        <!-- 5. Фильтр по статусу -->
        <StackPanel x:Name="sp_filter"
                    Grid.Row="4"
                    Orientation="Horizontal"
                    Visibility="{Binding IsSearchUiVisible, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,10">
            <CheckBox x:Name="ChkFilterWaiting"
                      Content="Ожидает оплаты"
                      IsChecked="{Binding FilterWaiting, Mode=TwoWay}"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      FontSize="12"
                      Margin="0,0,12,0"/>
            <CheckBox x:Name="ChkFilterActive"
                      Content="Активна"
                      IsChecked="{Binding FilterActive, Mode=TwoWay}"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      FontSize="12"
                      Margin="0,0,12,0"/>
            <CheckBox x:Name="ChkFilterFinished"
                      Content="Завершена"
                      IsChecked="{Binding FilterFinished, Mode=TwoWay}"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      FontSize="12"/>
        </StackPanel>

        <!-- 6. Действия с выбранными карточками -->
        <StackPanel x:Name="sp_actions"
                    Grid.Row="5"
                    Visibility="{Binding IsSearchUiVisible, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,10">
            <ui:Button x:Name="BtnCopySelected"
                       Content="Скопировать пермалинки"
                       Icon="{ui:SymbolIcon Copy24}"
                       Appearance="Secondary"
                       HorizontalAlignment="Stretch"
                       Command="{Binding CopySelectedCommand}"/>
        </StackPanel>

        <!-- 7. Результаты парсинга — карточки вместо таблицы, так читаемее -->
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TbCountMarketing"
                       Grid.Row="0"
                       Text="{Binding ResultsCountText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Margin="0,0,0,8"
                       Visibility="{Binding IsSearchUiVisible, Converter={StaticResource BoolToVis}}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="sp_results" ItemsSource="{Binding Items}"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
