<Window x:Class="SupporTik.Views.MarketingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:SupporTik.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:SupporTik.Controls"
        xmlns:vm="clr-namespace:SupporTik.ViewModels"
        mc:Ignorable="d"
        Title="Меню рекламы"
        Width="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate DataType="{x:Type vm:MarketingItemViewModel}">
            <controls:MarketingItemPanel/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="Auto"/>
            <!-- Статус авторизации -->
            <RowDefinition Height="Auto"/>
            <!-- WebView2 для входа -->
            <RowDefinition Height="Auto"/>
            <!-- Поиск -->
            <RowDefinition Height="Auto"/>
            <!-- Фильтр по статусу -->
            <RowDefinition Height="Auto"/>
            <!-- Действия с выбранными -->
            <RowDefinition Height="*"/>
            <!-- Результаты -->
        </Grid.RowDefinitions>

        <!-- 1. Шапка -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Меню рекламы"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <ui:Button Grid.Column="1"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Appearance="Transparent"
                       Padding="6,4"
                       WindowChrome.IsHitTestVisibleInChrome="True"
                       Click="Close_Click"/>
        </Grid>

        <!-- 2. Статус авторизации -->
        <TextBlock x:Name="TbLoginStatus"
                   Grid.Row="1"
                   Text="Проверка авторизации..."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Visibility="Collapsed"/>

        <!-- 3. Окно входа — видно только пока пользователь ещё не авторизован -->
        <wv2:WebView2 x:Name="webView"
                      Grid.Row="2"
                      Height="380"
                      Visibility="Collapsed"
                      Margin="0,0,0,10"/>

        <!-- 4. Поиск по UID — появляется после успешной авторизации -->
        <StackPanel x:Name="sp_search"
                    Grid.Row="3"
                    Orientation="Horizontal"
                    Visibility="{Binding IsSearchUiVisible, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,10">
            <ui:TextBox x:Name="UidTextBox"
                        Width="140"
                        PlaceholderText="UID пользователя"
                        Text="{Binding Uid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,8,0"/>
            <ui:Button x:Name="SearchButton"
                       Content="{Binding SearchButtonLabel}"
                       Icon="{ui:SymbolIcon Search24}"
                       Appearance="Primary"
                       Margin="0,0,8,0"
                       Command="{Binding SearchCommand}"/>
            <ui:ProgressRing Width="18"
                              Height="18"
                              IsIndeterminate="True"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
            <ui:TextBlock Text="Ничего не найдёно....."
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Visibility="{Binding NothingToSearch, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- 5. Фильтр по статусу — кнопка со сводкой + выпадающая панель галок (можно
             выбрать сразу несколько статусов) -->
        <Grid x:Name="sp_filter"
              Grid.Row="4"
              Visibility="{Binding IsSearchUiVisible, Converter={StaticResource BoolToVis}}"
              Margin="0,0,0,10">
            <ui:Button x:Name="BtnStatusFilter"
                       Content="{Binding StatusFilterSummary}"
                       Icon="{ui:SymbolIcon Filter24}"
                       Appearance="Secondary"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left"
                       Click="BtnStatusFilter_Click"/>

            <Popup x:Name="StatusFilterPopup"
                   PlacementTarget="{Binding ElementName=BtnStatusFilter}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Width="220">
                    <ItemsControl ItemsSource="{Binding StatusFilters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Status}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          FontSize="12"
                                          Margin="0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>

        <!-- 6. Действия с выбранными карточками -->
        <StackPanel x:Name="sp_actions"
                    Grid.Row="5"
                    Visibility="{Binding IsSearchUiVisible, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,10">
            <ui:Button x:Name="BtnCopySelected"
                       Content="Скопировать пермалинки"
                       Icon="{ui:SymbolIcon Copy24}"
                       Appearance="Secondary"
                       HorizontalAlignment="Stretch"
                       Margin="0,0,0,8"
                       Command="{Binding CopySelectedCommand}"/>
            <ui:Button x:Name="BtnCheckUpsales"
                       Content="{Binding UpsaleButtonLabel}"
                       Icon="{ui:SymbolIcon ArrowTrendingLines24}"
                       Appearance="Secondary"
                       HorizontalAlignment="Stretch"
                       Command="{Binding CheckUpsalesCommand}"/>
        </StackPanel>

        <!-- 7. Результаты парсинга — карточки вместо таблицы, так читаемее -->
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,8"
                  Visibility="{Binding IsSearchUiVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TbCountMarketing"
                           Grid.Column="0"
                           Text="{Binding ResultsCountText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <CheckBox x:Name="ChkSelectAll"
                          Grid.Column="1"
                          Content="Выбрать все"
                          IsChecked="{Binding SelectAll, Mode=TwoWay}"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          FontSize="12"
                          VerticalAlignment="Center"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="sp_results" ItemsSource="{Binding Items}"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
